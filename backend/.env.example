# ---------------------------------------------------------------
# API DevHub Africa — variables d'environnement
# Copier en .env (jamais commité) et compléter.
# ---------------------------------------------------------------

PORT=8787
HOST=127.0.0.1

# URL publique du front, et URL publique sous laquelle /api est servie.
# En développement, Vite proxifie /api : les deux valent http://localhost:5199
APP_URL=http://localhost:5199
API_URL=http://localhost:5199

# PostgreSQL (production chez Systalink). Vide → PostgreSQL embarqué (PGlite) dans .data/
DATABASE_URL=

# Facultatif : relève la limite de l'API GitHub (60 → 5 000 requêtes/heure).
# Créer un jeton « fine-grained » sans aucune permission : https://github.com/settings/tokens
GITHUB_TOKEN=

# ---- Connexion GitHub (OAuth App) ----
# https://github.com/settings/developers → New OAuth App
#   Homepage URL : APP_URL
#   Authorization callback URL : {API_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Connexion GitLab ----
# https://gitlab.com/-/user_settings/applications → scope « read_user »
#   Redirect URI : {API_URL}/api/auth/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com

# ---- Connexion Google ----
# https://console.cloud.google.com/apis/credentials → Create OAuth client ID (Web application)
#   Authorized redirect URI : {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Collecte des actualités (minutes). INGEST_DISABLED=1 pour la couper (tests).
INGEST_EVERY_MINUTES=15
INGEST_DISABLED=
