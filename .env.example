# Variables d'environnement DevHub Africa.
# Copier en .env pour le développement. Ne JAMAIS commiter de .env rempli.
# Les valeurs de production sont dans les secrets GitHub Actions et dans /srv/devhub/.env sur le VPS.
# Validation au démarrage : apps/api/src/infrastructure/config (l'API refuse de démarrer si une variable manque).

# ── Général ──
NODE_ENV=development
PROCESS_ROLE=http                     # http | worker
APP_URL=http://localhost:5173         # origine du front (CORS, CSRF, liens d'e-mail)
API_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# ── Base de données (PostgreSQL Systalink en production) ──
DATABASE_URL=postgresql://devhub:devhub@localhost:5432/devhub

# ── Sécurité ──
SESSION_SECRET=                       # openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=                 # 32 octets en base64 : openssl rand -base64 32

# ── OAuth ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=                     # P1
GITLAB_CLIENT_SECRET=                 # P1
GOOGLE_CLIENT_ID=                     # P1
GOOGLE_CLIENT_SECRET=                 # P1
AUTH_FAKE_PROVIDER=false              # true seulement en local et en CI ; interdit en production

# ── Actualités (module news) ──
NEWS_IMAGE_CACHE_DIR=                 # vide = dossier temporaire du système ; cache des images redimensionnées

# ── IA (appels côté serveur uniquement) ──
LLM_API_KEY=                          # vide = FakeLlmAdapter (réponses déterministes)
LLM_MODEL=claude-sonnet-5-5
LLM_HOURLY_QUOTA_PER_USER=10
LLM_HINT_TIMEOUT_MS=10000

# ── Messagerie pro Systalink (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DevHub Africa <notifications@exemple.africa>"

# ── Stockage objet Systalink (P2, si accepté) ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Notifications (P1) ──
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Sondes Systalink (écran /systalink) ──
BACKUP_STATUS_URL=                    # ou chemin du fichier d'état écrit par backup.sh
