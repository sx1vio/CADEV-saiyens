# Caddy : TLS automatique, en-têtes de sécurité, front statique, routage vers l'API.
# Voir docs/architecture/11-infrastructure-deploiement.md et 10-securite.md.

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		# Appliquée depuis le 10/11/2026 (le script du thème est passé dans /theme-init.js).
		# Images d'articles et logos : servies par le proxy /api/v1/img, donc 'self'.
		# Le service worker met en cache avatars GitHub et miniatures YouTube avec fetch() :
		# ces hôtes doivent aussi figurer dans connect-src, sinon l'image casse une fois le SW actif.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com https://i.ytimg.com; connect-src 'self' https://api.github.com https://avatars.githubusercontent.com https://i.ytimg.com; font-src 'self' data:; worker-src 'self'; manifest-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Temps réel : pas de tampon, pas de compression
	handle /api/v1/events* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# API, aperçus de partage (Open Graph), Proof Cards, badges README
	@api path /api/* /readyz /u/* /p/* /og/* /badge/*
	handle @api {
		reverse_proxy api:3000
	}

	# Service worker et manifeste : jamais mis en cache durablement
	@nocache path /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	# Fichiers avec empreinte : cache d'un an
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Front (SPA) avec repli sur index.html. Copies Brotli écrites au build (NET-01) : Caddy ne
	# compresse qu'en zstd et gzip, et Safari ne lit pas zstd.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server {
			precompressed br
		}
	}
}

# www.<domaine> renvoie vers le domaine nu (enregistrement DNS « www » vers le même serveur).
www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# Espace d'administration (apps/admin) : adresse à part, jamais liée depuis le site.
# Sans ADMIN_ADDRESS, ce bloc écoute sur 127.0.0.1:8081 (port non publié) et l'API garde
# l'administration désactivée (ADMIN_URL vide : toutes les routes /api/v1/admin/* en 404).
{$ADMIN_ADDRESS:http://127.0.0.1:8081} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Cache-Control "no-store"
		-Server
	}

	# Seules les routes d’administration et de session sont relayées vers l’API, plus le proxy
	# d’images public (aperçus des contenus dans l’onglet « Actus et skills »).
	@adminapi path /api/v1/admin /api/v1/admin/* /api/v1/img
	handle @adminapi {
		reverse_proxy api:3000
	}
	handle /api/* {
		respond 404
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

# Portail entreprise (apps/business) : business.<domaine>. Seules les routes /api/v1/business/*
# sont relayées ; l'API refuse ces routes si BUSINESS_URL n'est pas défini.
{$BUSINESS_ADDRESS:http://127.0.0.1:8082} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	@bizapi path /api/v1/business /api/v1/business/*
	handle @bizapi {
		reverse_proxy api:3000
	}
	handle /api/* {
		respond 404
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv/business
		try_files {path} /index.html
		file_server
	}
}
