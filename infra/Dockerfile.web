# Image Caddy qui embarque le build du front.
# À ajuster lors de l'initialisation d'apps/web (6 octobre).
FROM node:24-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @devhub/web... build
# Espace d'administration : build à part, servi sur sa propre adresse (ADMIN_ADDRESS).
RUN pnpm --filter @devhub/admin... build
# Portail entreprise : build à part, servi sur BUSINESS_ADDRESS.
RUN pnpm --filter @devhub/business... build

FROM caddy:2-alpine
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/apps/web/dist /srv/www
COPY --from=build /repo/apps/admin/dist /srv/admin
COPY --from=build /repo/apps/business/dist /srv/business
