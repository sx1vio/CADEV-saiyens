# Image de l'API et du worker (même code, deux points d'entrée).
# À ajuster lors de l'initialisation d'apps/api (6-7 octobre).
FROM node:24-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @devhub/api... build
RUN pnpm --filter @devhub/web... build          # index.html nécessaire aux aperçus Open Graph (ADR-0012)
RUN pnpm deploy --filter @devhub/api --prod /out

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out ./
COPY --from=build /repo/apps/web/dist/index.html ./web/index.html
USER node
EXPOSE 3000
# Les migrations sont lancées par deploy.sh avant le démarrage (prisma migrate deploy).
CMD ["node", "dist/main.js"]
