{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example", "packages/config/**"],
  "globalPassThroughEnv": ["DATABASE_URL", "APP_URL", "AUTH_FAKE_PROVIDER", "LOG_LEVEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
